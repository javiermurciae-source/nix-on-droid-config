#!/usr/bin/env bash

LINKER=$(find /nix/store -maxdepth 3 -name "ld-linux-aarch64.so.1" 2>/dev/null | sort -V | tail -n1)
if [ -z "$LINKER" ]; then
  echo "Error: Nix glibc linker not found" >&2
  exit 1
fi
GLIBC_DIR="$(dirname "$LINKER")"

KC_BIN="/data/data/com.termux.launcher.nix/files/usr/lib/node_modules/@keelcode-ai/keelcode/node_modules/@keelcode-ai/keelcode-linux-arm64/bin/keelcode"
if [ ! -f "$KC_BIN" ]; then
  echo "Error: keelcode binary not found at $KC_BIN" >&2
  echo "Install with: npm install -g @keelcode-ai/keelcode" >&2
  exit 1
fi

export LD_LIBRARY_PATH="$GLIBC_DIR:$LD_LIBRARY_PATH"
unset LD_PRELOAD

exec "$LINKER" "$KC_BIN" "$@"
