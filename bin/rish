#!/usr/bin/env bash
BASEDIR="$HOME/bin"
DEX="$BASEDIR/rish_shizuku.dex"

if [ ! -f "$DEX" ]; then
  echo "Cannot find $DEX" >&2
  exit 1
fi

export RISH_APPLICATION_ID="com.termux.launcher.nix"
export MANAGER_APPLICATION_ID="moe.shizuku.privileged.api"
export PATH="/system/bin:/system/xbin:/vendor/bin:$PATH"

# Limpiar variables de librerías dinámicas de Nix para no romper el linker bionic de Android
unset LD_LIBRARY_PATH
unset LD_PRELOAD

exec /system/bin/app_process -Djava.class.path="$DEX" /system/bin --nice-name=rish rikka.shizuku.shell.ShizukuShellLoader "$@"
